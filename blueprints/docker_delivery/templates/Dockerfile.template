FROM ghcr.io/astral-sh/uv:0.12.9-python3.14-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /application

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN uv sync --frozen --no-dev

FROM python:3.14.7-slim-bookworm AS runtime

RUN groupadd --gid 10001 application \
    && useradd --uid 10001 --gid application --no-create-home --shell /usr/sbin/nologin application

WORKDIR /application
COPY --from=builder --chown=application:application /application /application

ENV PATH="/application/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER application
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2)"]

CMD ["uvicorn", "${package_name}.asgi:application", "--host", "0.0.0.0", "--port", "8000"]
