package main

import (
	"fmt"
	"io"
	"os"
)

// run keeps output injectable so command behavior can be tested without a subprocess.
func run(stdout io.Writer) error {
	_, err := fmt.Fprintln(stdout, "scaffold compiler go example")
	return err
}

func main() {
	if err := run(os.Stdout); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
