#include <stdio.h>

#include "${target_name}/calculator.h"

int main(void) {
    int result = 0;
    if (!calculator_add(20, 22, &result) || result != 42) {
        fputs("calculation failed\n", stderr);
        return 1;
    }
    return puts("scaffold compiler c example") == EOF || fflush(stdout) == EOF ? 1 : 0;
}
