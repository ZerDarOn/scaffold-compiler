from fastapi.testclient import TestClient

from ${package_name}.application import create_application


def test_health_and_openapi_contract() -> None:
    with TestClient(create_application()) as client:
        assert client.get("/health/live").json() == {"status": "alive"}
        assert client.get("/health/ready").json() == {"status": "ready"}
        assert client.get("/api/v1").status_code == 200
        assert client.get("/openapi.json").status_code == 200
        assert client.get("/health/live").headers["x-request-id"]


def test_failed_readiness_returns_service_unavailable() -> None:
    async def not_ready() -> bool:
        return False

    with TestClient(create_application(readiness_probe=not_ready)) as client:
        response = client.get("/health/ready")

    assert response.status_code == 503
    assert response.json() == {"status": "not_ready"}
